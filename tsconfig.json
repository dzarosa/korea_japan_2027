/* TypeScript-Konfiguration für das Projekt "Korea-Japan-Reise" 
  Die Datei tsconfig.json enthält die Konfigurationseinstellungen für den TypeSccript.
  tsconfig.app.json ist eine separate Konfigurationsdatei, die speziell für die Anwendung verwendet wird und die Einstellungen aus tsconfig.json erweitert.
  tsconfig.node.json ist eine separate Konfigurationsdatei, die speziell für Node.js verwendet wird und die Einstellungen aus tsconfig.json erweitert.
  Außerdem ist ein Pfad-Alias definiert, damit Imports mit @/ auf den src-Ordner verweisen können.

*/
{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [ "./src/*" ]
    }
  }
}
